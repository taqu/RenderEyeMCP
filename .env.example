# RenderEyeMCP configuration
# Copy to .env and adjust values as needed.
# The installer creates this file automatically in the installation directory.

# RenderDoc GUI executable.
# Automatically populated by the installer when detected.
# Set explicitly if RenderDoc is installed to a non-standard location.
RENDEREYE_RENDERDOC_EXE=

# IPC settings (TCP connection between the RenderDoc extension and MCP server)
# RENDEREYE_IPC_HOST=127.0.0.1
# RENDEREYE_IPC_PORT=37020
# RENDEREYE_CONNECTION_TIMEOUT=10.0

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# RENDEREYE_LOG_LEVEL=INFO

# SQLite database path for capture and session records.
# Defaults to %APPDATA%\rendereye_mcp\captures.db on Windows.
# RENDEREYE_STORAGE_PATH=

# Capture registry settings
# RENDEREYE_CAPTURE_ENABLED=true
# RENDEREYE_CAPTURE_DIRS=C:\Users\<USERNAME>\captures
# RENDEREYE_CAPTURE_SCAN_INTERVAL=10.0
# RENDEREYE_CAPTURE_STABILITY_SECONDS=2.0
